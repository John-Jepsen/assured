# Insurance AI — example configuration. Copy to `.env` and edit as needed.
# The demo runs fully on defaults (mock/local providers) with NO secrets set.
# NEVER commit a real .env. All values are read with the INSURANCE_AI_ prefix.

# --- runtime ---
INSURANCE_AI_ENVIRONMENT=dev
INSURANCE_AI_HARDWARE_PROFILE=local-cpu        # local-cpu | apple-silicon | nvidia | cloud-gpu
INSURANCE_AI_LOG_LEVEL=INFO
# JSON list of exact browser origins; production accepts HTTPS origins only.
INSURANCE_AI_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8080"]
# Must be false in production; hides the synthetic customer directory.
INSURANCE_AI_DEMO_FEATURES_ENABLED=true

# --- application identity ---
# Production requires OIDC. The edge/login layer should forward Bearer access tokens
# for HTTP and an HttpOnly, Secure, SameSite cookie for browser WebSockets.
# INSURANCE_AI_AUTHENTICATION_MODE=oidc
# INSURANCE_AI_OIDC_ISSUER=https://identity.example.com/
# INSURANCE_AI_OIDC_AUDIENCE=https://api.assured.example
# INSURANCE_AI_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# INSURANCE_AI_OIDC_ALGORITHM=RS256
# INSURANCE_AI_OIDC_CUSTOMER_ID_CLAIM=customer_id
# INSURANCE_AI_OIDC_ROLES_CLAIM=roles
# INSURANCE_AI_OIDC_ADMIN_ROLES=["assured-admin"]
# INSURANCE_AI_OIDC_ACCESS_TOKEN_COOKIE=assured_access_token

# --- observability ---
# OpenTelemetry tracing is off by default and needs the `otel` extra.
# INSURANCE_AI_OTEL_ENABLED=false
# INSURANCE_AI_OTEL_SERVICE_NAME=insurance-ai-api
# Prometheus /metrics endpoint. Off by default; returns 404 while disabled.
# Enabling it REQUIRES INSURANCE_AI_METRICS_TOKEN (startup fails otherwise);
# scrapers must send `Authorization: Bearer <token>`.
# INSURANCE_AI_METRICS_ENABLED=false
# INSURANCE_AI_METRICS_TOKEN=replace-with-a-long-random-scrape-token

# --- database (compose sets this automatically inside Docker) ---
# INSURANCE_AI_DATABASE_URL=postgresql+asyncpg://insurance:insurance@localhost:5432/insurance_ai

# --- provider selection (which implementation runs) ---
INSURANCE_AI_LLM_PROVIDER=mock                 # mock | openai | ollama | huggingface
INSURANCE_AI_STT_PROVIDER=mock                 # mock | faster-whisper
INSURANCE_AI_TTS_PROVIDER=mock                 # mock | piper | kokoro
INSURANCE_AI_EMBEDDING_PROVIDER=hash           # hash | sentence-transformers | openai
INSURANCE_AI_VECTOR_BACKEND=numpy              # numpy | pgvector
INSURANCE_AI_PAYMENT_PROVIDER=mock             # mock | stripe
INSURANCE_AI_TELEPHONY_PROVIDER=none           # none | twilio

# --- model ids (HF-style; used by the real adapters) ---
INSURANCE_AI_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
INSURANCE_AI_STT_MODEL=Systran/faster-whisper-base.en
INSURANCE_AI_TTS_VOICE=en_US-amy-medium
# INSURANCE_AI_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# INSURANCE_AI_EMBEDDING_DIM=384

# --- optional external LLM ---
# INSURANCE_AI_OPENAI_API_KEY=sk-...
# INSURANCE_AI_OPENAI_BASE_URL=https://api.openai.com/v1
# INSURANCE_AI_OLLAMA_BASE_URL=http://localhost:11434
# Dedicated Hugging Face/vLLM OpenAI-compatible model endpoint (never loaded in API).
# INSURANCE_AI_HUGGINGFACE_BASE_URL=http://localhost:8001/v1
# INSURANCE_AI_HUGGINGFACE_TOKEN=replace-with-model-service-api-key
# INSURANCE_AI_HUGGINGFACE_MODEL_REVISION=989aa7980e4cf806f80c7fef2b1adb7bc71aa306
# INSURANCE_AI_LLM_CONNECT_TIMEOUT_SECONDS=10
# INSURANCE_AI_LLM_REQUEST_TIMEOUT_SECONDS=120
# INSURANCE_AI_LLM_MAX_RETRIES=2
# INSURANCE_AI_LLM_MAX_TOKENS=400
# INSURANCE_AI_LLM_MAX_CONCURRENCY=8
# INSURANCE_AI_LLM_MAX_PENDING_REQUESTS=16
# INSURANCE_AI_LLM_QUEUE_TIMEOUT_SECONDS=2
# INSURANCE_AI_LLM_CIRCUIT_FAILURE_THRESHOLD=5
# INSURANCE_AI_LLM_CIRCUIT_RECOVERY_SECONDS=30

# --- easy real models via Ollama (no keys) -------------------------------------
# Prefer the one-command overlay:
#   docker compose -f docker-compose.yml -f docker-compose.models.yml up --build
# To run real models LOCALLY (host Ollama at :11434), set instead:
# INSURANCE_AI_LLM_PROVIDER=ollama
# INSURANCE_AI_LLM_MODEL=qwen2.5:0.5b
# INSURANCE_AI_EMBEDDING_PROVIDER=ollama
# INSURANCE_AI_EMBEDDING_MODEL=nomic-embed-text
# INSURANCE_AI_EMBEDDING_DIM=768
# INSURANCE_AI_RAG_MIN_SCORE=0.6            # dense-similarity cutoff for nomic

# --- payments (Stripe TEST mode only — never live) ---
# INSURANCE_AI_STRIPE_SECRET_KEY=sk_test_...
# INSURANCE_AI_STRIPE_WEBHOOK_SECRET=whsec_...

# --- telephony (Twilio) ---
# INSURANCE_AI_TWILIO_ACCOUNT_SID=AC...
# INSURANCE_AI_TWILIO_AUTH_TOKEN=...
# INSURANCE_AI_PUBLIC_BASE_URL=https://your-ngrok-subdomain.ngrok.io

# --- verification demo ---
INSURANCE_AI_OTP_CODE_FOR_DEMO=123456
# Production must leave INSURANCE_AI_OTP_CODE_FOR_DEMO unset.

# --- session state ---
# Compose enables Redis automatically. Local host development defaults to memory.
# Production requires Redis with a non-demo credential (prefer a secret reference).
# INSURANCE_AI_SESSION_BACKEND=redis
# INSURANCE_AI_REDIS_URL=rediss://:strong-secret@redis.internal:6379/0
# INSURANCE_AI_SESSION_TTL_SECONDS=3600
# INSURANCE_AI_SESSION_LOCK_TIMEOUT_SECONDS=180
# INSURANCE_AI_SESSION_LOCK_BLOCKING_TIMEOUT_SECONDS=10

# --- rate limits ---
# Fixed-window counters per source IP and per authenticated principal. Counters live in
# Redis when INSURANCE_AI_SESSION_BACKEND=redis (shared across replicas), otherwise in a
# bounded in-process map. Production rejects rate_limit_enabled=false and
# rate_limit_fail_open=true at startup.
# INSURANCE_AI_RATE_LIMIT_ENABLED=true
# Whether requests are allowed through when the counter backend errors.
# INSURANCE_AI_RATE_LIMIT_FAIL_OPEN=false
# Window length shared by every limit below; max 3600.
# INSURANCE_AI_RATE_LIMIT_WINDOW_SECONDS=60
# HTTP: all /api/ requests by IP, authenticated customer/admin requests by subject.
# INSURANCE_AI_RATE_LIMIT_HTTP_IP_REQUESTS=300
# INSURANCE_AI_RATE_LIMIT_HTTP_PRINCIPAL_REQUESTS=60
# WebSocket: chat/voice handshakes per window.
# INSURANCE_AI_RATE_LIMIT_WEBSOCKET_IP_CONNECTIONS=30
# INSURANCE_AI_RATE_LIMIT_WEBSOCKET_PRINCIPAL_CONNECTIONS=10
# WebSocket: chat turns and completed voice utterances per window.
# INSURANCE_AI_RATE_LIMIT_WEBSOCKET_IP_ACTIONS=120
# INSURANCE_AI_RATE_LIMIT_WEBSOCKET_PRINCIPAL_ACTIONS=30
# Cardinality bound for the in-memory limiter only (ignored with Redis).
# INSURANCE_AI_RATE_LIMIT_MEMORY_MAX_BUCKETS=10000
